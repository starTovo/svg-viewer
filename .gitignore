# ==========================================================================
# _local/ —— 本機專屬，全部不入库：构建工具链(153MB)、测试环境、截图
# 工具链用 android/setup-tools.sh 重建；测试环境用 npm i 恢复；截图由验证脚本重生成
# ==========================================================================
_local/

# 构建产物
android/build/
android/out/
android/gen/
android/.home/
android/.verify/
android/.v/
**/*.class
**/*.dex
**/*.apk
**/*.idsig

# 签名密钥（绝不入库，务必另行备份）
*.keystore
*.jks

# 截图（可由验证脚本重新生成）
*.png

# 生成的走查台快照（node make-review.cjs 重新生成）
ui-review.html

# src/assets/index.html 是 app/index.html 的构建副本，由 build.sh 每次自动同步。
# 不入库，避免出现两份会各自漂移的"真源"。
android/src/assets/index.html

# 验证输出 / 一次性调试脚本（不是源码，也不是文档）
app/qa-out*.txt
app/qa-results.json
app/qa-v5-results.json
app/lock.txt
app/pinch-before.json
app/pinch-after.json
qa/*.py
qa/*.err
qa/*.svg

# 本地工具状态
.workbuddy/*
!.workbuddy/memory/
!.workbuddy/memory/**

# 临时 / 调试残留
enc2.txt
enc.json
enc.txt
*.tmp
*.log
.DS_Store
Thumbs.db
