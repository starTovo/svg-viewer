# 本地构建工具链 / 测试环境 / 截图，不入库
# 下面几条是防御性规则：即使有人在仓库内重新造出这些目录，也不会被提交
_local/
.workbuddy/
.tools/
node_modules/

# 构建产物
android/build/
android/out/
android/gen/
android/.home/
android/.verify/
android/.v/
**/*.class
**/*.dex
**/*.apk
**/*.idsig

# 签名密钥（绝不入库，务必另行备份）
*.keystore
*.jks

# 截图（可由验证脚本重新生成）
*.png

# 生成的走查台快照（node make-review.cjs 重新生成）
ui-review.html

# src/assets/index.html 是 app/index.html 的构建副本，由 build.sh 每次自动同步。
# 不入库，避免出现两份会各自漂移的"真源"。
android/src/assets/index.html

# 验证输出 / 一次性调试脚本（不是源码，也不是文档）
app/qa-out*.txt
app/qa-results.json
app/qa-v5-results.json
app/lock.txt
app/pinch-before.json
app/pinch-after.json

# 临时 / 调试残留
enc2.txt
enc.json
enc.txt
*.tmp
*.log
.DS_Store
Thumbs.db
